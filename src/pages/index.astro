---
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout>
  <section class="space-y-4">
    <h1 class="text-3xl font-bold tracking-tight">
      Metro Atlanta Transit Advocacy Intelligence
    </h1>

    <p class="max-w-2xl text-neutral-300">
      A public, data-driven hub for understanding transit goals, agencies, and advocacy efforts across Metro Atlanta.
      Use this site as a jumping-off point for deeper sources and how to take action.
    </p>

    <div class="mt-8 rounded-xl border border-neutral-800 bg-neutral-900/40 p-6">
      <p class="text-neutral-400 italic">
        Map placeholder — we’ll mount a Svelte interactive map component here next.
      </p>
    </div>
  </section>
</BaseLayout>
