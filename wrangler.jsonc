{
	"name": "metro-atl-transit-tracker",
	"compatibility_date": "2026-02-19",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},
	// CF_ACCESS_* are JWT validation parameters, not credentials — safe to commit.
	// The team domain is the public *.cloudflareaccess.com host users see at login;
	// the AUD is a public application identifier checked against the `aud` claim.
	// Neither value can be used to forge a token (signing keys live in Cloudflare).
	"vars": {
		"CF_ACCESS_TEAM_DOMAIN": "frootsnoops.cloudflareaccess.com",
		"CF_ACCESS_AUD": "96f0e12e20cbdf4fd6f78aaecf0129add7fbc21883156fc4b2f703c4cccc3638",
		"WRITE_RATE_LIMIT_ENABLED": "true"
	},
	"main": ".svelte-kit/cloudflare/_worker.js",
	"workers_dev": false,
	"preview_urls": false,
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"routes": [
		{
			"pattern": "maitai.observer",
			"custom_domain": true
		},
		{
			"pattern": "www.maitai.observer",
			"custom_domain": true
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "metro-atl-transit-prod",
			"database_id": "043e7490-6a07-44a7-b235-285cd36ba7c8",
			"migrations_dir": "migrations/d1",
			"migrations_table": "d1_migrations"
		}
	],
	"unsafe": {
		"bindings": [
			{
				"name": "WRITE_LIMITER",
				"type": "ratelimit",
				"namespace_id": "1001",
				"simple": { "limit": 30, "period": 60 }
			}
		]
	},
	"env": {
		"staging": {
			// See note above the top-level `vars` block: CF_ACCESS_* are public validation parameters.
			"vars": {
				"CF_ACCESS_TEAM_DOMAIN": "frootsnoops.cloudflareaccess.com",
				"CF_ACCESS_AUD": "96f0e12e20cbdf4fd6f78aaecf0129add7fbc21883156fc4b2f703c4cccc3638",
				"WRITE_RATE_LIMIT_ENABLED": "true"
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "metro-atl-transit-staging",
					"database_id": "990bf4ea-cfc8-487d-b3db-b027176f4129",
					"migrations_dir": "migrations/d1",
					"migrations_table": "d1_migrations"
				}
			],
			"unsafe": {
				"bindings": [
					{
						"name": "WRITE_LIMITER",
						"type": "ratelimit",
						"namespace_id": "1002",
						"simple": { "limit": 30, "period": 60 }
					}
				]
			}
		}
	}
}
