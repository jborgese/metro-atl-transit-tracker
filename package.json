{
  "name": "metro-atl-transit-tracker",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite dev",
    "d1:migrate:local": "wrangler d1 migrations apply metro-atl-transit-prod --local",
    "build": "svelte-kit sync && vite build",
    "deploy": "npm run build && wrangler deploy",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=99",
    "typecheck": "npm run check",
    "test": "svelte-kit sync && vitest run",
    "test:watch": "svelte-kit sync && vitest",
    "test:coverage": "svelte-kit sync && vitest run --coverage",
    "schema:check": "node scripts/check-d1-schema.mjs",
    "test:smoke": "node scripts/smoke-content-api.mjs",
    "test:integration": "node scripts/integration-content-api.mjs",
    "test:all": "npm run test && npm run test:smoke && npm run test:integration",
    "ci:gate": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run schema:check && npm run test:smoke",
    "ci:gate:full": "npm run ci:gate && npm run test:integration",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "build:org-logos": "node scripts/build-org-logos.js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "jose": "^6.1.3",
    "maplibre-gl": "^5.16.0",
    "mimetext": "^3.0.28",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "@cloudflare/workers-types": "^5.20261110.1",
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-cloudflare": "^8.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@testing-library/svelte": "^5.4.2",
    "@types/geojson": "^7946.0.16",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.24.1",
    "jsdom": "^31.0.1",
    "png-to-ico": "^3.0.1",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^4.1.1",
    "sharp": "^0.34.5",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.5",
    "svelte-eslint-parser": "^1.4.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.12",
    "vitest": "^5.1.0",
    "wrangler": "^4.159.0"
  },
  "imports": {
    "#lib/*": "./src/lib/*",
    "#types": "./src/types/index.ts",
    "#types/*": "./src/types/*",
    "#utils/*": "./src/utils/*"
  }
}
