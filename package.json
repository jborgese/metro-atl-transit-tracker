{
  "name": "metro-atl-transit-tracker",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "vite dev",
    "d1:migrate:local": "wrangler d1 migrations apply metro-atl-transit-prod --local",
    "build": "svelte-kit sync && vite build",
    "deploy": "wrangler deploy",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "npm run check",
    "schema:check": "node scripts/check-d1-schema.mjs",
    "test:smoke": "node scripts/smoke-content-api.mjs",
    "test:integration": "node scripts/integration-content-api.mjs",
    "test:all": "npm run test:smoke && npm run test:integration",
    "ci:gate": "npm run typecheck && npm run lint && npm run schema:check && npm run test:smoke",
    "ci:gate:full": "npm run ci:gate && npm run test:integration",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "build:org-logos": "node scripts/build-org-logos.js"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "jose": "^6.1.3",
    "maplibre-gl": "^5.16.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "^7.2.8",
    "@sveltejs/kit": "^2.50.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/typography": "^0.5.19",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.14.0",
    "png-to-ico": "^3.0.1",
    "prettier": "^3.8.1",
    "sharp": "^0.34.5",
    "svelte": "^5.49.1",
    "svelte-check": "^4.4.1",
    "svelte-eslint-parser": "^1.4.1",
    "svelte-preprocess": "^6.0.3",
    "vite": "^7.3.1",
    "wrangler": "^4.67.0"
  }
}
