{
  "name": "metro-atl-transit-tracker",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "vite dev",
    "d1:migrate:local": "wrangler d1 migrations apply metro-atl-transit-prod --local",
    "build": "svelte-kit sync && vite build",
    "deploy": "npm run build && wrangler deploy",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=140",
    "typecheck": "npm run check",
    "test": "svelte-kit sync && vitest run",
    "test:watch": "svelte-kit sync && vitest",
    "test:coverage": "svelte-kit sync && vitest run --coverage",
    "schema:check": "node scripts/check-d1-schema.mjs",
    "test:smoke": "node scripts/smoke-content-api.mjs",
    "test:integration": "node scripts/integration-content-api.mjs",
    "test:all": "npm run test && npm run test:smoke && npm run test:integration",
    "ci:gate": "npm run typecheck && npm run lint && npm run test && npm run schema:check && npm run test:smoke",
    "ci:gate:full": "npm run ci:gate && npm run test:integration",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "build:org-logos": "node scripts/build-org-logos.js"
  },
  "dependencies": {
    "jose": "^6.1.3",
    "maplibre-gl": "^5.16.0",
    "tailwindcss": "^4.1.18",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.15.2",
    "@cloudflare/workers-types": "^4.20260501.1",
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-cloudflare": "^7.2.8",
    "@sveltejs/kit": "^2.50.1",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/geojson": "^7946.0.16",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.14.0",
    "png-to-ico": "^3.0.1",
    "prettier": "^3.8.1",
    "sharp": "^0.34.5",
    "svelte": "^5.49.1",
    "svelte-check": "^4.4.1",
    "svelte-eslint-parser": "^1.4.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.5",
    "wrangler": "^4.67.0"
  }
}
