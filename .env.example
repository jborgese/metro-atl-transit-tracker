PUBLIC_MAPTILER_KEY=your_maptiler_key_here

# Cloudflare Access JWT verification for write routes.
CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
CF_ACCESS_AUD=your-access-audience-tag

# Optional local/CI token auth mode for smoke/integration tests only.
# Honored ONLY when the request hostname is localhost/127.0.0.1 — refused on
# deployed hostnames even if these env vars are set.
# EDITOR_TOKEN_AUTH_ENABLED=false
# EDITOR_API_TOKEN=

# Optional RBAC allowlists (CSV, case-insensitive emails/identities).
# If all three are unset, all authenticated Access users can perform write actions.
CF_ACCESS_RBAC_EDITORS=
CF_ACCESS_RBAC_ARCHIVERS=
CF_ACCESS_RBAC_ADMINS=

# Write-path rate limiting kill switch. The actual limit/period are configured
# on the WRITE_LIMITER binding in wrangler.jsonc (unsafe.bindings) and enforced
# globally by the Cloudflare runtime.
WRITE_RATE_LIMIT_ENABLED=true
