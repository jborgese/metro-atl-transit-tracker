{
  "permissions": {
    "allow": [
      "mcp__cloudflare-bindings__accounts_list",
      "mcp__cloudflare-observability__accounts_list",
      "mcp__cloudflare-bindings__d1_databases_list",
      "mcp__cloudflare-bindings__set_active_account",
      "mcp__cloudflare-observability__set_active_account",
      "mcp__cloudflare-bindings__workers_list",
      "mcp__cloudflare-bindings__r2_buckets_list",
      "mcp__cloudflare-bindings__d1_database_query",
      "mcp__cloudflare-observability__query_worker_observability",
      "mcp__cloudflare-bindings__workers_get_worker",
      "mcp__cloudflare-observability__observability_keys",
      "mcp__cloudflare-observability__observability_values",
      "mcp__cloudflare-bindings__workers_get_worker_code",
      "mcp__cloudflare-bindings__search_cloudflare_documentation",
      "PowerShell(gh run list --limit 5)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:beltlinerailnow.com)",
      "WebFetch(domain:www.letspropelatl.org)",
      "WebFetch(domain:www.martaarmy.org)",
      "WebSearch",
